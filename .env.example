# ===== log_system 开发环境配置（复制为 .env 使用，.env 已被 gitignore 忽略） =====
# 技术路线见 docs/tech-stack-mapping.md v1.5：
# 前端 Vue3 / 后端 FastAPI(Python) / 采集器 Fluent Bit / 检索 OpenSearch PPL
# 数据层 PostgreSQL + OpenSearch + Kafka + Flink + Redis 全部容器内联调（无生产数据）

# ---- PostgreSQL ----
POSTGRES_USER=loguser
POSTGRES_PASSWORD=logpass
POSTGRES_DB=logdb

# ---- OpenSearch（开发期已关安全插件，无需账号密码） ----
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
# 索引分片/副本：测试单节点 1/0；生产多节点按磁盘与节点数调大（如 3/1）。
# 索引按天滚动后，单分片建议控制在 25GB 左右，50GB/天配 3 分片。
OPENSEARCH_SHARDS=1
OPENSEARCH_REPLICAS=0

# ---- Redis（Agent 心跳时间戳 / 检索缓存 / 会话） ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Kafka（采集→消费解耦，Flink 输入源） ----
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_RAW=ruilog.logs.raw
KAFKA_TOPIC_DLQ=ruilog.logs.dlq

# ---- Flink（实时流处理 Job：清洗→双写 OS/CH→告警） ----
FLINK_JOBMANAGER=flink-jobmanager:8081

# ---- ClickHouse（双引擎的聚合引擎；OS 明细 / CH 聚合） ----
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=ruilog
CLICKHOUSE_USER=ruilog
CLICKHOUSE_PASSWORD=ruilogpass

# ---- 写入链路模式：kafka(主干) | dual(双写过渡) | direct(旧链路直写OS) ----
# 阶段2默认 dual： ingest 同时写 Kafka 与 OS，前端查询不受影响；
# Flink Job 稳定后切 kafka，再由 Flink 统一写 OS+CH；回滚用 direct。
INGEST_STORAGE_MODE=dual

# ---- 聚合查询引擎开关：ch(ClickHouse 双引擎聚合) | os(OpenSearch 回退) ----
AGG_ENGINE=ch

# ---- JWT（auth-service 签发） ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 平台管理种子密码（可选覆盖；留空则用 db.py 内置演示默认值，生产必须先改）----
# 种子仅在账号不存在时插入，改这两个变量不会改动已有账号的密码。
# AUTH_SEED_ADMIN_PASSWORD=
# AUTH_SEED_DEMO_PASSWORD=

# ---- 前端暴露端口（宿主映射） ----
WEB_PORT=8080

# ---- ai-service（AI 能力配置中心）----
# 默认复用上面的 PostgreSQL；如需独立库可覆盖整条 DSN
# AI_PG_DSN=dbname=logdb user=loguser password=logpass host=postgres port=5432
# 语法规则库「同步索引字段」读取的真实字段来源
AI_INGEST_META_URL=http://ingest-service:8000/meta
# 模型接入：仅支持「商用 API」与「本地自定义（Ollama / oMLX）」两类，均走 OpenAI 兼容 HTTP。
# WorkBuddy / CodeBuddy CLI 接入方式已于 2026-11-17 下线，容器不再挂载宿主 CLI，也不再需要宿主机桥接。
