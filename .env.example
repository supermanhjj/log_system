# ===== log_system 开发环境配置（复制为 .env 使用，.env 已被 gitignore 忽略） =====
# 技术路线见 docs/tech-stack-mapping.md v1.5：
# 前端 Vue3 / 后端 FastAPI(Python) / 采集器 Fluent Bit / 检索 OpenSearch PPL
# 数据层 PostgreSQL + OpenSearch + Kafka + Flink + Redis 全部容器内联调（无生产数据）

# ---- PostgreSQL ----
POSTGRES_USER=loguser
POSTGRES_PASSWORD=logpass
POSTGRES_DB=logdb

# ---- OpenSearch（开发期已关安全插件，无需账号密码） ----
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# ---- Redis（Agent 心跳时间戳 / 检索缓存 / 会话） ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Kafka（采集→消费解耦，Flink 输入源） ----
KAFKA_BROKER=kafka:9092

# ---- Flink（实时告警 Job） ----
FLINK_JOBMANAGER=flink-jobmanager:8081

# ---- JWT（auth-service 签发） ----
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 前端暴露端口（宿主映射） ----
WEB_PORT=8080

# ---- ai-service（AI 能力配置中心）----
# 默认复用上面的 PostgreSQL；如需独立库可覆盖整条 DSN
# AI_PG_DSN=dbname=logdb user=loguser password=logpass host=postgres port=5432
# 语法规则库「同步索引字段」读取的真实字段来源
AI_INGEST_META_URL=http://ingest-service:8000/meta
# WorkBuddy CLI 接入：路径按 ai-service 容器内视角解析。
# 宿主机 ~/.local/bin/codebuddy 需先挂载进容器（例如 compose 增加 volumes），
# 再在「智能管理 → WorkBuddy CLI」里填写容器内路径；未挂载时连通性测试会如实报不可达。
