{
  "index_patterns": [
    "logs-*-*"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s",
      "index.mapping.total_fields.limit": 2000,
      "index.plugins.index_state_management.policy_id": "ruilog-detail-retention",
      "analysis": {
        "filter": {
          "ruilog_word_delimiter": {
            "type": "word_delimiter_graph",
            "preserve_original": true,
            "split_on_case_change": true,
            "split_on_numerics": true,
            "stem_english_possessive": false
          }
        },
        "analyzer": {
          "ruilog_text": {
            "type": "custom",
            "tokenizer": "standard",
            "filter": [
              "ruilog_word_delimiter",
              "lowercase"
            ]
          }
        }
      }
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "tenant_id": {
          "type": "keyword"
        },
        "log_class": {
          "type": "keyword"
        },
        "source_type": {
          "type": "keyword"
        },
        "app": {
          "type": "keyword"
        },
        "instance": {
          "type": "keyword"
        },
        "host": {
          "type": "keyword"
        },
        "level": {
          "type": "keyword"
        },
        "severity": {
          "type": "integer"
        },
        "facility": {
          "type": "keyword"
        },
        "pid": {
          "type": "integer"
        },
        "source": {
          "type": "keyword"
        },
        "traceId": {
          "type": "keyword"
        },
        "status": {
          "type": "integer"
        },
        "message": {
          "type": "text",
          "analyzer": "ruilog_text"
        },
        "raw": {
          "type": "text",
          "analyzer": "ruilog_text"
        },
        "log": {
          "type": "text",
          "analyzer": "ruilog_text"
        },
        "stream": {
          "type": "keyword"
        },
        "logtag": {
          "type": "keyword"
        },
        "attrs": {
          "type": "flat_object"
        },
        "src_file": {
          "type": "keyword"
        },
        "collector_id": {
          "type": "keyword"
        },
        "env": {
          "type": "keyword"
        },
        "ingested_at": {
          "type": "date"
        },
        "parse_status": {
          "type": "keyword"
        }
      }
    }
  }
}
