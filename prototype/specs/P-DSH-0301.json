        "FLT-003",
        "FLT-004",
        "FLT-005",
        "INP-005"
      ]
    },
    {
      "id": "C-DSH-02",
      "type": "table",
      "size": "default",
      "props": {
        "stickyHeader": true,
        "columns": [
          "checkbox",
          "name",
          "folder",
          "owner",
          "chartCount",
          "updateTime",
          "status",
          "action"
