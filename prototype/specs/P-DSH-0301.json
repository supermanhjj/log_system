        "batchBar": true,
        "pagination": {
          "pageSize": 20,
          "options": [
            20,
            50,
            100
          ]
        }
      },
      "states": [
        "default",
        "hover",
        "active",
        "focus-visible",
        "disabled",
        "loading"
      ],
