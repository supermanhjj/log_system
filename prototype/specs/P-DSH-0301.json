      "id": "C-DSH-03",
      "type": "pagination",
      "props": {
        "pageSize": 20,
        "options": [
          20,
          50,
          100
        ]
      },
      "states": [
        "default",
        "hover",
        "disabled",
        "focus-visible"
      ],
      "states_omitted": {
        "active": "按压与 hover 视觉一致",
        "loading": "翻页加载由表格承接",
        "error": "失败由页面级 error 承接"
      },
      "rules": [
        "DSC-009",
        "TBL-012"
      ]
    },
    {
      "id": "C-DSH-04",
      "type": "status-tag",
      "variant": "normal",
      "props": {
        "text": "运行中",
        "dot": true
